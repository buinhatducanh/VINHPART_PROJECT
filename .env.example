# Neon PostgreSQL Database
# Get your connection strings from Neon Console: https://console.neon.tech

# Pooled connection - for Prisma Client
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-PROJECT.neon.tech/neondb?sslmode=require"

# Direct connection - for Prisma Migrate
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-PROJECT.neon.tech/neondb?sslmode=require"
