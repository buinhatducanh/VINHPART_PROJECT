{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "start": "cross-env NODE_ENV=production tsx backend/src/server.ts",
    "dev:client": "vite --config frontend/vite.config.ts",
    "dev:server": "tsx watch -r dotenv/config backend/src/server.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "build:full": "prisma generate --schema backend/prisma/schema.prisma && vite build --config frontend/vite.config.ts",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:push": "prisma db push --schema backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "db:studio": "prisma studio --schema backend/prisma/schema.prisma",
    "db:seed": "tsx -r dotenv/config backend/prisma/seed.ts",
    "db:api": "tsx -r dotenv/config backend/src/server.ts"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
